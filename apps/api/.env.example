PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ping
# APNs credentials (.p8 key can be pasted with \n escapes)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=
APPLE_APNS_KEY_P8=
# Set false for production APNs host
APPLE_APNS_USE_SANDBOX=true

# CloudKit web auth verification
CLOUDKIT_CONTAINER_ID=
CLOUDKIT_ENV=development
CLOUDKIT_API_TOKEN=

# Debug logging (never logs raw tokens/secrets)
DEBUG_CLOUDKIT_AUTH=false
DEBUG_DB=false
