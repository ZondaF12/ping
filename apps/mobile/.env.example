# Nest API base URL (no trailing slash).
# Simulator on the same Mac: http://127.0.0.1:3000 is OK.
# Physical iPhone: use your computer's LAN IP, e.g. http://192.168.1.42:3000 (localhost on the phone is the phone itself).
# Railway / HTTPS hosting: use the public URL only, e.g. https://your-service.up.railway.app — do NOT add :3000.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
